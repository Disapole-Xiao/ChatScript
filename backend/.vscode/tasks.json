{
    "version": "2.0.0",
    "tasks": [
      {
        "type": "shell",
        "command": "npx",
        "args": [
          "tsx",
          "${file}"
        ],
        "group": {
          "kind": "test"
        },
        "label": "tsx",
        "problemMatcher": [],
        "options": {
          "cwd": "${fileDirname}"
        }
      },
      {
        "type": "typescript",
        "tsconfig": "tsconfig.json",
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "label": "tsc: 构建 - tsconfig.json"
      }
    ]
  }
  